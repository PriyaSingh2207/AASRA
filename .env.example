# Sarvam AI API Key (For 16 Indic Languages TTS, Speech Recognition, & Mayura Translation)
# Get yours from https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Groq / Grok LPU High-Speed AI API Key (For Dynamic Cognitive Game Difficulty & Clinical Insights)
# Get yours from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROK_API_KEY=your_groq_api_key_here

# Server Host & Port Configuration
AASRA_HOST=127.0.0.1
AASRA_PORT=8000
